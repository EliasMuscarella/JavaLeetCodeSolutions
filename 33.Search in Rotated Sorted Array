class Solution {
    public int search(int[] nums, int target) {
        int l = 0;
        int r = nums.length -1;

        int pivot = findPivot(nums);
        
        if(pivot == 0){
            return binarySearch(0,r,nums,target);
        }else if(target >= nums[0]){
            return binarySearch(0,pivot-1,nums,target);
        }else{
            return binarySearch(pivot,r,nums,target);
        }
    }

    public int findPivot(int[] nums){
       int l = 0;
       int r = nums.length - 1; 

        if(nums[l] <= nums[r]){
            return 0;
        }
        
        //find pivot
        while(l<=r){
            int mid = l + (r - l)/2;

            if(mid < nums.length - 1 && nums[mid] > nums[mid +1]){
                return mid + 1;
            }

            if(nums[mid] >= nums[l]){
                l = mid + 1;
            }
            else{
                r = mid - 1;
            }
        }
        return -1;
    }

    public int binarySearch(int l, int r, int[] nums, int target){
        while(l<=r){
            int mid = l + (r - l)/2;

            if(nums[mid] == target){
                return mid;
            }
            else if(nums[mid]<target){
                l = mid + 1;
            }
            else if(nums[mid] > target){
                r = mid - 1;
            }
        }

        return -1;
    }
}
