class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int max = -1;

        //find the biggest pile
        for(int i = 0;i < piles.length;i++){
            max = Math.max(max,piles[i]);
        }


        //binary search through possible speeds
        int l = 1;
        int r = max;
        int result = max;

        while(l<=r){
            int mid = (l+r)/2;
            if(numHours(piles,mid) <= h){
                result = mid;
                r = mid - 1;
            }
            else{
                l = mid + 1;
            }
        }

        return result;
    }

    public int numHours(int [] piles, int speed){
        int result = 0;
        for(int i = 0; i < piles.length;i++){
            result += Math.ceil((double)piles[i] / speed);
        }
        return result;
    }
}
