class Solution {
    public int largestRectangleArea(int[] heights) {
        //stack holding pairs of (index it could have started at, height)
        Deque<int[]> stack = new ArrayDeque<>();
        int max = 0;

        for(int i = 0;i<heights.length;i++){
            int index = i;
            while(!stack.isEmpty() && stack.peek()[1] > heights[i]){
                int[] info = stack.pop();
                index = info[0];
                max = Math.max(max, info[1] * (i - info[0]));
            }
            
            stack.push(new int[]{index, heights[i]});
        }

        while(!stack.isEmpty()){
            int[] info = stack.pop();
            max = Math.max(max, info[1] * (heights.length - info[0]));
        }

        return max;
    }
}
