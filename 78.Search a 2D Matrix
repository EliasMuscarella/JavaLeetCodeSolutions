class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        int r = (matrix.length) * (matrix[0].length) - 1;
        int l = 0;

        while(l <= r){
            int row = (((l + r)/2)/matrix[0].length);
            int col = (((l + r)/2)%matrix[0].length);
            if(matrix[row][col] == target){
                return true;
            }
            else if(matrix[row][col] > target){
                r = row * matrix[0].length + col - 1;
            }
            else{
                l = (row * matrix[0].length + col + 1);
            }
        }

        return false;
    }
}
