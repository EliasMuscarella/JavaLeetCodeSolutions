class Solution {
    public int longestConsecutive(int[] nums) {
    HashSet<Integer> set = new HashSet<>();
        int max = 0;

        for(int num : nums){
            set.add(num);
        }

        for(int num : set){
            if(!set.contains(num-1)){
                int count = 0;
                int value = num;
                while(set.contains(value)){
                    count++;
                    value++;
                }
                max = Math.max(count, max);
            }
        }

        return max;
    }
}
