class Solution {
    public int lengthOfLongestSubstring(String s) {
        int max = 0;
        int l = 0;
        int r = 0;
        int[] lastUsed = new int[128];
        Arrays.fill(lastUsed,-1);

        while(r < s.length()){
            char c = s.charAt(r);
            if(lastUsed[c] >= l){
                l = lastUsed[c] + 1;
            }

            lastUsed[c] = r;
            max = Math.max(max, r-l + 1);

            r++;
        }

        return max;
    }
}
