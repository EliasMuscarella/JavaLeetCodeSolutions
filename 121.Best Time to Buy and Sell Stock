class Solution {
    public int maxProfit(int[] prices) {
        int result = 0;
        int min = prices[0];
        int max = prices[0];

        for(int price : prices){
            if(price < min){
                min = price;
                max = price;
            }
            else if (price > max){
                max = price;
            }
            result = Math.max(result, max - min);
        }
        return result;
    }
}
