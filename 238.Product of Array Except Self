class Solution {
    public int[] productExceptSelf(int[] nums) {
        int [] result = new int[nums.length];

        int product = 1;
        int index = 0;

        while(index < nums.length){
            result[index] = product;
            product *= nums[index];
            index++;
        }

        product = 1;
        index = nums.length-1;
        while(index >= 0){
            result[index] *= product;
            product *= nums[index];
            index--;
        }

        return result;
    }
}
