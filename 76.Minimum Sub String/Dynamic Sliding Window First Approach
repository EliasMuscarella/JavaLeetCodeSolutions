class Solution {
    public String minWindow(String s, String t) {
        //return empty string if t is bigger than s
        if(t.length() > s.length()){
            return "";
        }

        //declare window pointers
        int l = 0;
        int r = 0;
        int count = 0;
        int unique = 0;
        int minL = 0;
        int minR = Integer.MAX_VALUE;
        HashMap<Character, Integer> window = new HashMap<>();
        HashMap<Character, Integer> tChars = new HashMap<>();
        for(char c : t.toCharArray()){
            unique = (tChars.get(c) == null) ? unique + 1 : unique;
            tChars.put(c,tChars.getOrDefault(c, 0)+1);
        }

        while(r < s.length()){
            char c = s.charAt(r);
            if(tChars.containsKey(c)){
                window.put(c, window.getOrDefault(c, 0) + 1);
                //if this is a new char from t increment count
                if(window.get(c).equals(tChars.get(c))){
                    count++;
                }

                //if we have seen this char before increment l to next char in substring
                while(l < r && (tChars.get(s.charAt(l)) == null || window.get(s.charAt(l)) > tChars.get(s.charAt(l)))){
                    if(tChars.containsKey(s.charAt(l))){
                        window.put(s.charAt(l),window.get(s.charAt(l))-1);
                    }
                    l++;
                }

                //if we have all chars in our substring check if its a new min
                if(count == unique && r - l < minR - minL){
                    minL = l;
                    minR = r;
                }
            }
            
            //increment r
            r++;
        }

        return count == unique ? s.substring(minL,minR + 1) : "";
    }
}
